generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int                 @id @default(autoincrement())
  email             String?             @unique
  number            String?              @unique @default("")
  password          String              @default("")
  name              String?
  auth_type         AuthType          @default(Credentials)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  onRampTransaction OnRampTransaction[]
  balance           Balance?
  sentTransfers     p2pTransfer[]       @relation("FromUser")
  receivedTransfers p2pTransfer[]       @relation("ToUser")
  payoutTransactions PayoutTransaction[]
}

model Merchant {
  id           Int                     @id @default(autoincrement())
  email        String                  @unique
  name         String?
  number       String?                 // Phone number — collected during onboarding
  auth_type    AuthType
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  balance      MerchantBalance?
  transactions MerchantTransaction[]
  payoutTransactions  MerchantPayoutTransaction[]
  transactionsOut     MerchantTransactionOut[]
  paymentRequests     PaymentRequest[]
}

model Balance {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  amount    Int      @default(0)   // stored in paise (1 INR = 100 paise)
  locked    Int      @default(0)   // reserved amount (future: escrow)
  user      User     @relation(fields: [userId], references: [id])
}

model MerchantBalance {
  id         Int      @id @default(autoincrement())
  merchantId Int      @unique
  amount     Int      @default(0)
  locked     Int      @default(0)
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model OnRampTransaction {
  id        Int          @id @default(autoincrement())
  status    OnRampStatus
  token     String       @unique
  provider  String
  amount    Int
  startTime DateTime
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
}

model p2pTransfer {
  id         Int      @id @default(autoincrement())
  amount     Int
  timestamp  DateTime
  fromUserId Int
  toUserId   Int
  fromUser   User     @relation("FromUser", fields: [fromUserId], references: [id])
  toUser     User     @relation("ToUser", fields: [toUserId], references: [id])
}

model MerchantTransaction {
  id         Int      @id @default(autoincrement())
  amount     Int
  timestamp  DateTime @default(now())
  merchantId Int
  fromUserId Int
  status     String   @default("completed")
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model PayoutTransaction {
  id        Int          @id @default(autoincrement())
  status    OnRampStatus // reuse existing Processing/Success/Failure enum
  token     String       @unique
  provider  String
  amount    Int
  startTime DateTime
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
}

model MerchantPayoutTransaction {
  id         Int          @id @default(autoincrement())
  status     OnRampStatus
  token      String       @unique
  provider   String
  amount     Int
  startTime  DateTime
  merchantId Int
  merchant   Merchant     @relation(fields: [merchantId], references: [id])
}

model MerchantTransactionOut {  // merchant -> user payout / refund
  id         Int      @id @default(autoincrement())
  amount     Int
  timestamp  DateTime @default(now())
  merchantId Int
  toUserId   Int
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model PaymentRequest {  // real payment-link records (replaces the client-side Math.random() id)
  id          String   @id @default(cuid())
  merchantId  Int
  amount      Int
  description String
  status      String   @default("pending") // pending | paid | expired
  createdAt   DateTime @default(now())
  merchant    Merchant @relation(fields: [merchantId], references: [id])
}

enum OnRampStatus {
  Success
  Failure
  Processing
}

enum AuthType {
  Google
  Github
  Credentials
}
